#!/usr/bin/env bash

set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
version="v8.30.1"
temporary="$(mktemp -d "${TMPDIR:-/tmp}/drizz-secret.XXXXXX")"

cleanup() {
  rm -rf "${temporary}"
}

trap cleanup EXIT
cd "${root}"

git ls-files --cached --others --exclude-standard -z \
  | while IFS= read -r -d '' path; do
      if [[ -f "${path}" ]]; then
        printf '%s\0' "${path}"
      fi
    done \
  | tar --null -T - -cf - \
  | tar -xf - -C "${temporary}"
go run "github.com/zricethezav/gitleaks/v8@${version}" dir --no-banner --no-color --redact "${temporary}"
